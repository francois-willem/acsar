---
import Layout from '../../layouts/Layout.astro';
export function getStaticPaths(){return [{params:{service:'air-conditioning'},props:{name:'Air conditioning',headline:'A little cooler.\nA lot more comfortable.',description:'Air conditioning installation, servicing and repairs in Malmesbury, Cape Town and surrounding areas. Talk to ACSAR about comfort for your home or business.',intro:'Create a comfortable space with air conditioning that suits your needs. ACSAR offers installation, servicing and repairs in Malmesbury, Cape Town and surrounding areas.',items:[['New installations','Tell us about your space, how it is used and your cooling needs. We can discuss the next steps for a suitable installation.'],['Existing systems','From routine servicing to a unit that needs attention, tell us what you are experiencing so we can help assess the next step.'],['Planning your project','Room size, sunlight, insulation and usage all affect your cooling needs. Have these details ready when you get in touch.']]}},{params:{service:'refrigeration'},props:{name:'Refrigeration',headline:'Keeping things cool.\nKeeping you going.',description:'Refrigeration installation, servicing and repairs from ACSAR in Malmesbury, Cape Town and surrounding areas. Discuss your refrigeration requirements.',intro:'Refrigeration needs dependable care. ACSAR installs, services and repairs refrigeration systems in Malmesbury, Cape Town and surrounding areas.',items:[['Installation','Discuss the type of refrigeration you need, your available space and how the system will be used.'],['Servicing & maintenance','Keep an eye on performance and arrange servicing for an existing system. Share the unit details when contacting us.'],['Repairs','Unusual temperatures, sounds or operation? Describe the symptoms and provide the make and model so we can discuss assistance.']]}},{params:{service:'servicing'},props:{name:'Service & repairs',headline:'Better care.\nEvery season.',description:'Aircon and refrigeration servicing, maintenance and repairs in Malmesbury. Contact ACSAR for help with an existing system.',intro:'Look after the systems that keep your space comfortable. ACSAR provides air conditioning and refrigeration servicing, repairs and maintenance.',items:[['Routine servicing','A service gives your system attention and provides an opportunity to identify issues affecting its operation.'],['Faults & repairs','Tell us about reduced cooling, leaks, unusual noises or other symptoms. Include your unit’s make and model.'],['Ongoing maintenance','Discuss your equipment, how often it is used and its service history so we can advise on suitable maintenance.']]}}];}
const {name,headline,description,intro,items}=Astro.props;
---
<Layout title={`${name} in Malmesbury | ACSAR`} description={description}><section class="section container service-page"><a class="text-link" href="/#services">← All services</a><p class="eyebrow">ACSAR / {name.toUpperCase()}</p><h1 style="white-space:pre-line">{headline}</h1><p class="intro">{intro}</p><a class="button" href="/contact/">Discuss your needs <span>↗</span></a><div class="service-grid">{items.map(([title,text])=><article class="service-card"><h2>{title}</h2><p>{text}</p></article>)}</div><div class="contact-panel"><h2>Based in Malmesbury. Serving surrounding areas.</h2><p>Send us your location and a few details about your project to confirm availability.</p><a class="text-link" href="/contact/">Get in touch ↗</a></div></section></Layout>
